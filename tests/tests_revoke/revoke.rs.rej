--- tests/tests_revoke/revoke.rs	2026-09-17 03:31:29.327447136 +0000
+++ tests/tests_revoke/revoke.rs	2026-09-17 03:31:29.332444703 +0000
@@ -32,8 +32,13 @@
         assert!(is_token_revoked("tok-2", &map));
     }
 
+    /// The stored value says when the record may be dropped, not when
+    /// refusal starts: an entry kept until a future date revokes the
+    /// token right away. (It used to do nothing until that date, which
+    /// is also when the purge removed it — `/adm/revoke` with an `exp`
+    /// never revoked anything.)
     #[test]
-    fn token_with_future_exp_is_not_revoked() {
+    fn token_with_future_exp_is_revoked_immediately() {
         let map = make_revoked_map();
         let future = std::time::SystemTime::now()
             .duration_since(std::time::UNIX_EPOCH)
@@ -41,7 +46,7 @@
             .as_secs()
             + 3600; // 1 hour from now
         map.insert("tok-3".into(), future);
-        assert!(!is_token_revoked("tok-3", &map));
+        assert!(is_token_revoked("tok-3", &map));
     }
 
     #[test]
@@ -54,18 +59,125 @@
             .unwrap()
             .as_secs()
             + 7200;
-        map.insert("valid-1".into(), future);
+        map.insert("revoked-3".into(), future);
 
         assert!(is_token_revoked("revoked-1", &map));
         assert!(is_token_revoked("revoked-2", &map));
-        assert!(!is_token_revoked("valid-1", &map));
+        assert!(is_token_revoked("revoked-3", &map));
         assert!(!is_token_revoked("unknown", &map));
     }
 
+    // ── how long a record is kept ────────────────────────────
+
+    use proxyauth::revoke::load::{
+        is_plain_token_id, revocation_purge_at, revocation_record_until,
+    };
+
+    const NOW: u64 = 1_900_000_000;
+    const LIFETIME: u64 = 3600;
+
+    #[test]
+    fn logout_keeps_the_record_until_the_token_expires() {
+        use proxyauth::revoke::load::logout_record_until;
+        assert_eq!(logout_record_until(NOW + 1200, NOW), NOW + 1200);
+        // Never permanent, never already in the past.
+        assert_eq!(logout_record_until(NOW - 5, NOW), NOW);
+        assert_ne!(logout_record_until(0, 0), 0);
+    }
+
+    #[test]
+    fn an_admin_revocation_lasts_as_long_as_any_live_token() {
+        assert_eq!(revocation_record_until(NOW, LIFETIME), NOW + LIFETIME);
+        assert_ne!(revocation_record_until(0, 0), 0, "never an unbounded entry");
+    }
+
+    #[test]
+    fn a_record_is_purged_only_after_its_date() {
+        // The purge keeps an entry while `purge_at > now`.
+        let keep_until = revocation_record_until(NOW, LIFETIME);
+        let purge_at = revocation_purge_at("tok", keep_until);
+        assert!(purge_at > NOW + LIFETIME - 1, "still kept while any token issued before NOW lives");
+    }
+
+    // ── LMDB record layout ───────────────────────────────────
+
+    use proxyauth::revoke::db::{RevocationRecord, decode_record, encode_record};
+
+    #[test]
+    fn records_keep_both_instants() {
+        let record = RevocationRecord { revoked_at: NOW, value: NOW + LIFETIME };
+        let bytes = encode_record(record);
+        assert_eq!(bytes.len(), 16);
+        assert_eq!(decode_record(&bytes), Some(record));
+    }
+
+    #[test]
+    fn records_written_by_older_versions_still_read() {
+        assert_eq!(
+            decode_record(&[]),
+            Some(RevocationRecord { revoked_at: 0, value: 0 }),
+            "old \"never\" entry"
+        );
+        assert_eq!(
+            decode_record(&(NOW + 5).to_be_bytes()),
+            Some(RevocationRecord { revoked_at: 0, value: NOW + 5 })
+        );
+        assert_eq!(decode_record(&[1, 2, 3]), None);
+    }
+
+    #[test]
+    fn internal_keys_are_not_token_ids() {
+        assert!(is_plain_token_id("3f2c9a"));
+        assert!(!is_plain_token_id(""));
+        assert!(!is_plain_token_id("   "));
+        assert!(!is_plain_token_id("rotated:3f2c9a"));
+    }
+
     #[test]
     fn empty_map_revokes_nothing() {
         let map = make_revoked_map();
         assert!(!is_token_revoked("anything", &map));
         assert!(!is_token_revoked("", &map));
     }
+
+    // ── purge and Redis expiry ───────────────────────────────
+
+    use proxyauth::revoke::db::{REDIS_MIN_TTL_SECS, purge_expired, redis_keys, redis_ttl_secs};
+    use proxyauth::revoke::load::{pack_rotation, rotated_key};
+
+    #[test]
+    fn purge_drops_only_entries_past_their_date() {
+        let map = make_revoked_map();
+        map.insert("permanent".into(), 0);
+        map.insert("expired".into(), NOW - 1);
+        map.insert("due-now".into(), NOW);
+        map.insert("later".into(), NOW + 60);
+        map.insert(rotated_key("rot-expired"), pack_rotation(NOW - 100, NOW - 1));
+        map.insert(rotated_key("rot-later"), pack_rotation(NOW - 100, NOW + 60));
+
+        let mut purged = purge_expired(&map, NOW);
+        purged.sort();
+        assert_eq!(purged, vec!["due-now", "expired", "rotated:rot-expired"]);
+        assert!(map.contains_key("permanent"));
+        assert!(map.contains_key("later"));
+        assert!(map.contains_key("rotated:rot-later"));
+    }
+
+    #[test]
+    fn redis_keys_expire_with_the_entry() {
+        assert_eq!(redis_ttl_secs("tok", 0, NOW), None, "permanent: no expiry");
+        assert_eq!(redis_ttl_secs("tok", NOW + 3600, NOW), Some(3600));
+        assert_eq!(
+            redis_ttl_secs("tok", NOW + 5, NOW),
+            Some(REDIS_MIN_TTL_SECS),
+            "long enough for every node to see it"
+        );
+        let packed = pack_rotation(NOW + 30, NOW + 1800);
+        assert_eq!(redis_ttl_secs(&rotated_key("tok"), packed, NOW), Some(1800));
+    }
+
+    #[test]
+    fn redis_key_names_are_unchanged() {
+        assert_eq!(redis_keys("abc"), ["token:abc", "abc_action", "abc_count"]);
+    }
 }
